
# --- env/ overrides (appended to the stock sormas-base/setup/sormas.properties by env/build.sh) ---
# Default region/district/community/facility/lab/point of entry and the default users on an empty database
createDefaultEntities=true
# No "Security Alert: default password" dialog after a default-user login (stock: false). Test environments only.
skipDefaultPasswordCheck=true
# Sender of notification mails; they go to the copy's SMTP sink (see the javamail resource in env/payara/payara-setup.sh)
email.sender.address=noreply@sormas.local
email.sender.name=SORMAS test env
