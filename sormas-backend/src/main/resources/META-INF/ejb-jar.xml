<?xml version="1.0" encoding="UTF-8"?>
<ejb-jar xmlns="https://jakarta.ee/xml/ns/jakartaee" version="4.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/ejb-jar_4_0.xsd">

	<interceptors>
		<interceptor>
			<interceptor-class>de.symeda.sormas.backend.audit.AuditLoggerInterceptor</interceptor-class>
		</interceptor>
		<interceptor>
			<interceptor-class>de.symeda.sormas.backend.util.PerformanceLoggingInterceptor</interceptor-class>
		</interceptor>
		<interceptor>
			<interceptor-class>de.symeda.sormas.backend.util.RightsAllowedInterceptor</interceptor-class>
		</interceptor>
		<interceptor>
			<interceptor-class>de.symeda.sormas.backend.util.ValidationConstraintViolationInterceptor</interceptor-class>
		</interceptor>
	</interceptors>
	<assembly-descriptor>
		<interceptor-binding>
			<ejb-name>*</ejb-name>
			<interceptor-class>de.symeda.sormas.backend.audit.AuditLoggerInterceptor</interceptor-class>
		</interceptor-binding>
		<interceptor-binding>
			<ejb-name>*</ejb-name>
			<interceptor-class>de.symeda.sormas.backend.util.PerformanceLoggingInterceptor</interceptor-class>
		</interceptor-binding>
		<interceptor-binding>
			<ejb-name>*</ejb-name>
			<interceptor-class>de.symeda.sormas.backend.util.RightsAllowedInterceptor</interceptor-class>
		</interceptor-binding>
		<interceptor-binding>
			<ejb-name>*</ejb-name>
			<interceptor-class>de.symeda.sormas.backend.util.ValidationConstraintViolationInterceptor</interceptor-class>
		</interceptor-binding>

		<application-exception>
			<exception-class>jakarta.validation.ValidationException</exception-class>
			<rollback>true</rollback>
		</application-exception>
		<application-exception>
			<exception-class>jakarta.validation.ConstraintViolationException</exception-class>
			<rollback>true</rollback>
		</application-exception>
		<application-exception>
			<exception-class>jakarta.persistence.EntityNotFoundException</exception-class>
			<rollback>true</rollback>
		</application-exception>
	</assembly-descriptor>
</ejb-jar>
