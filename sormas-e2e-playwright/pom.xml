<?xml version="1.0" encoding="UTF-8"?>
<!--
  End-to-end workflow tests (Playwright for Java + JUnit 5), run against app copies started with env/ (see README.md).
  Not part of the default build: sormas-base adds this module only with the profile e2e-playwright. It has no parent so
  that the build plugins of sormas-base (coverage, git info, enforcer) do not run here.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>de.symeda.sormas</groupId>
	<artifactId>sormas-e2e-playwright</artifactId>
	<version>1.104.0</version>
	<packaging>jar</packaging>
	<name>sormas-e2e-playwright</name>

	<properties>
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Same version as the Playwright for Node used by env/smoke.cjs and CI: the same Chromium build -->
		<playwright.version>1.63.0</playwright.version>
		<junit.version>5.14.4</junit.version>
		<gson.version>2.14.0</gson.version>

		<!-- Run settings (README.md "Settings"); override with -D on the command line -->
		<e2e.ports>18720-18721</e2e.ports>
		<e2e.project>sormas-e2e</e2e.project>
		<e2e.envDir>${project.basedir}/../env</e2e.envDir>
		<e2e.appSrc>${project.basedir}/..</e2e.appSrc>
		<e2e.keepCopies>false</e2e.keepCopies>
		<e2e.reuseCopies>false</e2e.reuseCopies>
		<e2e.headless>true</e2e.headless>
		<!-- JVM forks (failsafe forkCount); with e2e.copiesPerFork > 0 each fork owns that many consecutive ports counted from the first of e2e.ports -->
		<e2e.forks>1</e2e.forks>
		<e2e.copiesPerFork>0</e2e.copiesPerFork>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.microsoft.playwright</groupId>
			<artifactId>playwright</artifactId>
			<version>${playwright.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
			<version>${gson.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
			</plugin>
			<!-- No unit tests here; the workflow tests are integration tests (*IT) run by failsafe -->
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.6</version>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-failsafe-plugin</artifactId>
				<version>3.5.6</version>
				<configuration>
					<forkCount>${e2e.forks}</forkCount>
					<reuseForks>true</reuseForks>
					<systemPropertyVariables>
						<e2e.copiesPerFork>${e2e.copiesPerFork}</e2e.copiesPerFork>
						<e2e.forkNumber>${surefire.forkNumber}</e2e.forkNumber>
						<e2e.ports>${e2e.ports}</e2e.ports>
						<e2e.project>${e2e.project}</e2e.project>
						<e2e.envDir>${e2e.envDir}</e2e.envDir>
						<e2e.appSrc>${e2e.appSrc}</e2e.appSrc>
						<e2e.keepCopies>${e2e.keepCopies}</e2e.keepCopies>
						<e2e.reuseCopies>${e2e.reuseCopies}</e2e.reuseCopies>
						<e2e.headless>${e2e.headless}</e2e.headless>
						<e2e.out>${project.build.directory}/e2e</e2e.out>
					</systemPropertyVariables>
					<environmentVariables>
						<!-- Browsers are installed beforehand (README.md "Requirements"); the tests never download one -->
						<PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD>1</PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD>
					</environmentVariables>
					<trimStackTrace>false</trimStackTrace>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
