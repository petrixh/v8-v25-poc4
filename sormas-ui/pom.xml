	<build>
		<finalName>${project.artifactId}</finalName>

		<plugins>
			<plugin>
				<artifactId>maven-war-plugin</artifactId>
				<configuration>
					<!-- By attaching the classes to a separate JAR, we can import them
						directly in the production overlay project. -->
					<attachClasses>true</attachClasses>
					<!-- Theme files: sormas.css, bootstrap-grid.min.css, the fonts, the images and the favicon (Java code uses
						/VAADIN/themes/sormas/img/...). They live in src/main/frontend/themes/sormas/, where Flow dev mode looks them up for
						/VAADIN/themes/<name>/ requests; the war gets them at the same URL path for production mode. No theme is activated
						(no @Theme, no theme.json): SormasAppShell loads the two style sheets with @StyleSheet. The Valo .scss files in
						src/main/webapp/VAADIN/themes/sormas/ are not loaded; they are kept as a reference and still end up in the war -->
					<webResources>
						<resource>
							<directory>src/main/frontend/themes/sormas</directory>
							<targetPath>VAADIN/themes/sormas</targetPath>
						</resource>
					</webResources>
				</configuration>
			</plugin>
			<plugin>
				<groupId>com.vaadin</groupId>
				<artifactId>vaadin-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>prepare-frontend</id>
						<goals>
							<goal>prepare-frontend</goal>
						</goals>
					</execution>
					<execution>
						<id>build-frontend</id>
						<goals>
							<!-- Production mode. The Rich Text Editor is not in Vaadin's prebuilt bundle, so build-frontend builds the bundle
								(downloads Node to ~/.vaadin and the npm packages) and checks the commercial licence: it fails without a key -->
							<goal>build-frontend</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Vaadin development mode (-Pdev), for checks only (env/README.md "Development mode"; never a release or CI build): the war
			has vaadin-dev and no production bundle; flow-build-info.json (prepare-frontend) says productionMode false, which wins over
			the productionMode context-param of web.xml. At deploy time Flow needs the project folder (the token file names it) and
			builds its development bundle there -->
		<profile>
			<id>dev</id>
			<dependencies>
				<dependency>
					<groupId>com.vaadin</groupId>
					<artifactId>vaadin-dev</artifactId>
				</dependency>
			</dependencies>
			<build>
				<plugins>
					<plugin>
						<groupId>com.vaadin</groupId>
						<artifactId>vaadin-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>build-frontend</id>
								<phase>none</phase>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
